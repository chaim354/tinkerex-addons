#!/usr/bin/env bash
# Build and push the addon bundle image. Publishing this IS the addon deploy — no Rails redeploy is
# needed, because the Rails app fetches from this container at runtime via ADDON_SOURCE_URL.
#
# After pushing, roll the accessory from the TINKEREX repo:
#   kamal accessory reboot addons
#
# --platform linux/amd64 is required: the build box is arm64 (Apple Silicon), the Unraid host is
# amd64. Matches `builder: arch: amd64` in tinkerex's config/deploy.yml.
set -euo pipefail

IMAGE="ghcr.io/chaim354/tinkerex-addons"

# PROVENANCE IS STAMPED TWICE, AND THE TWO READERS ARE NOT REDUNDANT. `version.json` (the
# Dockerfile's BUNDLE_VERSION) answers "which bundle is running?" over HTTP; the OCI label below
# answers the same question from `docker inspect` ON THE BOX, with no HTTP at all — which is the
# reading you need exactly when nginx is the thing that is wrong, and the mechanism tinkerex's
# bin/build-sidecar already uses for every sidecar accessory (which also bakes the same revision
# into the image as /revision, read back through `kamal accessory exec` — the version.json twin):
#
#   docker inspect tinkerex-addons \
#     --format '{{index .Config.Labels "org.opencontainers.image.revision"}}'
#
# It read EMPTY here until 2026-08-25, so the two accessories answered that question by two
# different mechanisms and a `docker inspect` sweep over both silently reported one of them as
# unknown.
#
# ONE VALUE FEEDS BOTH, deliberately: two provenance stamps that can disagree are worse than one,
# and they WOULD have diverged on the dirty case (bin/revision).
#
# The dirty rule lives in bin/revision, shared with bin/publish's verify step.
REVISION="$(bin/revision)"

# Refuse to ship a bundle the host's system tests have never seen. See bin/check-fixture-drift for
# why publish time is the right moment, and why an absent sibling checkout only warns.
bin/check-fixture-drift

: "${KAMAL_REGISTRY_PASSWORD:?not set. Resolve it from op://tinkerex/ghcr.io/password via bin/secret in the tinkerex repo — see \"Deploying\" in README.md for the exact line. Do NOT use \"op item get ghcr.io\": a service-account shell is scoped to the tinkerex vault and that unqualified name resolves to an EMPTY string, which docker login then rejects confusingly}"
echo "$KAMAL_REGISTRY_PASSWORD" | docker login ghcr.io -u chaim354 --password-stdin

# The SHA tag carries $REVISION too, so a dirty build is never published under the clean SHA that
# `bin/rollback <sha>` resolves — a rollback to a tag that lied about its contents is the failure
# the suffix exists to prevent. A clean build tags exactly as it always did.
docker buildx build --platform linux/amd64 \
  --build-arg "BUNDLE_VERSION=$REVISION" \
  --label "org.opencontainers.image.revision=$REVISION" \
  -t "$IMAGE:$REVISION" -t "$IMAGE:latest" --push .
echo "pushed $IMAGE:$REVISION"
echo "roll it:   kamal accessory reboot addons   (from the tinkerex repo)"
echo "roll back: bin/rollback <earlier-sha>"
